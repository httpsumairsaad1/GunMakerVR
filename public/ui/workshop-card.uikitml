<meta preferred-color-scheme="dark" />
<style>
  .hud { width: 78; height: 42; flex-direction: column; justify-content: space-between; padding: 2.2; background-color: rgba(6, 16, 26, 0.92); border-color: #2fc8ff; border-width: 0.25; border-radius: 1.6; }
  .row { width: 73.6; flex-direction: row; justify-content: space-between; align-items: center; }
  .brand { font-size: 2.3; font-weight: 700; color: #ffb04a; }
  .wallet { font-size: 2; font-weight: 700; color: #dff4ff; }
  .track { width: 73.6; height: 1.1; background-color: #12303f; border-radius: 0.6; }
  .fill { width: 0; height: 1.1; background-color: #2fc8ff; border-radius: 0.6; }
  .green { background-color: #3dff8f; }
  .project { width: 73.6; font-size: 3; font-weight: 700; color: #ffffff; }
  .status { width: 73.6; font-size: 2.1; color: #7fd8ff; }
  .hint { width: 73.6; font-size: 1.9; color: #b9c9d4; }
  .reward { width: 73.6; font-size: 2.1; font-weight: 700; color: #3dff8f; }
  .btn { width: 23; height: 6.4; background-color: rgba(47, 200, 255, 0.14); border-color: #2fc8ff; border-width: 0.25; border-radius: 1.4; font-size: 2.1; font-weight: 700; color: #dff4ff; }
  .btn:hover { background-color: rgba(47, 200, 255, 0.4); }
  .red { border-color: #ff4d5e; background-color: rgba(255, 77, 94, 0.14); }
  .red:hover { background-color: rgba(255, 77, 94, 0.4); }
</style>
<Panel width="78" height="42">
  <div class="hud">
    <div class="row">
      <span class="brand">GUNMAKERVR // WORKSHOP</span>
      <span id="wallet" class="wallet">250 CR | LV 1 | 0 XP</span>
    </div>
    <div class="track"><div id="xp-fill" class="fill"></div></div>
    <div id="project" class="project">Current Project: none</div>
    <div id="status" class="status">Status: choose a blueprint</div>
    <div class="track"><div id="build-fill" class="fill green"></div></div>
    <div id="hint" class="hint">Pinch or point at a wall gun to select it.</div>
    <div id="reward" class="reward">Ready</div>
    <div class="row">
      <button id="btn-remove" class="btn">REMOVE PART</button>
      <button id="btn-reset" class="btn red">RESET BENCH</button>
      <button id="btn-menu" class="btn">MENU</button>
    </div>
  </div>
</Panel>
