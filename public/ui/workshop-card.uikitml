<Panel width="72" height="34">
  <div id="card" class="card">
    <div class="topline">
      <span class="brand">GUNSMITH / WORKSHOP</span>
      <span id="wallet">CREDITS  |  LV 1  |  0 XP</span>
    </div>
    <div id="selection" class="selection">Choose a gun from the wall</div>
    <div id="hint" class="hint">Pinch to grab. Hold to move. Turn it to inspect.</div>
    <button id="strip-part" class="action">REMOVE NEXT PART</button>
    <div id="reward" class="reward">+XP and credits appear here</div>
  </div>
</Panel>

