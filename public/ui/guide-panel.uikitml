<meta preferred-color-scheme="dark" />
<style>
  .card { width: 40; height: 46; flex-direction: column; gap: 1.3; padding: 2; background-color: rgba(6, 16, 26, 0.92); border-color: #2fc8ff; border-width: 0.25; border-radius: 1.6; }
  .title { font-size: 2.6; font-weight: 700; color: #ffb04a; }
  .sub { font-size: 2; font-weight: 700; color: #7fd8ff; }
  .row { width: 36; height: 4; flex-direction: row; align-items: center; gap: 1.4; }
  .dot { width: 2.2; height: 2.2; background-color: #334a58; border-radius: 0.5; }
  .name { font-size: 2; color: #dff4ff; }
  .status { font-size: 1.9; color: #3dff8f; }
  .btn { width: 36; height: 5.4; background-color: rgba(47, 200, 255, 0.14); border-color: #2fc8ff; border-width: 0.25; border-radius: 1.2; font-size: 2; font-weight: 700; color: #dff4ff; }
  .btn:hover { background-color: rgba(47, 200, 255, 0.4); }
  .alt { border-color: #ffb04a; background-color: rgba(255, 176, 74, 0.14); }
</style>
<Panel width="40" height="46">
  <div class="card">
    <span id="gd-title" class="title">ASSEMBLY GUIDE</span>
    <span id="gd-sub" class="sub">Pick a blueprint to begin</span>
    <div id="gs-1" class="row"><div id="gs-1-dot" class="dot"></div><span id="gs-1-name" class="name">-</span></div>
    <div id="gs-2" class="row"><div id="gs-2-dot" class="dot"></div><span id="gs-2-name" class="name">-</span></div>
    <div id="gs-3" class="row"><div id="gs-3-dot" class="dot"></div><span id="gs-3-name" class="name">-</span></div>
    <div id="gs-4" class="row"><div id="gs-4-dot" class="dot"></div><span id="gs-4-name" class="name">-</span></div>
    <div id="gs-5" class="row"><div id="gs-5-dot" class="dot"></div><span id="gs-5-name" class="name">-</span></div>
    <div id="gs-6" class="row"><div id="gs-6-dot" class="dot"></div><span id="gs-6-name" class="name">-</span></div>
    <div id="gs-7" class="row"><div id="gs-7-dot" class="dot"></div><span id="gs-7-name" class="name">-</span></div>
    <span id="gd-status" class="status">Waiting for a blueprint</span>
    <button id="gd-hint" class="btn">SHOW HINT</button>
    <button id="gd-skip" class="btn alt">SKIP TUTORIAL</button>
  </div>
</Panel>
